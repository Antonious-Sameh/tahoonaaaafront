# Copy this file to `.env` for local development. Never commit the real `.env`.
# On Vercel, set this as a Project Environment Variable instead of a file.

# Base URL of THIS system's OWN backend, including the /api suffix.
# Leave unset for local dev — it already defaults to http://localhost:4000/api
# (see src/config.js), which matches the backend's own local default port.
# For production, point this at THIS system's own deployed backend only —
# never at another System's backend:
# VITE_API_BASE_URL=https://your-own-backend.vercel.app/api
VITE_API_BASE_URL=
